# Это ШАБЛОН. Скопируйте файл как ".env" (без кавычек) и впишите свои значения.
# Файл .env уже добавлен в .gitignore - секреты в git не попадут.

# Ключ авторизации GigaChat API.
# Где взять: Личный кабинет Studio -> проект GigaChat API -> "Настройки API"
#            -> кнопка "Получить ключ" -> скопировать поле Authorization Key.
GIGACHAT_AUTHORIZATION_KEY=

# Версия API (scope). Обычно для физических лиц:
# GIGACHAT_API_PERS - физическое лицо
# GIGACHAT_API_B2B  - юридическое лицо, оплата пакетами токенов
# GIGACHAT_API_CORP - юридическое лицо, оплата по факту (pay-as-you-go)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat. Другие варианты: GigaChat-2-Max, GigaChat-2-Lite, GigaChat-3-Ultra.
GIGACHAT_MODEL=GigaChat-2-Pro

# Необязательно. Путь к файлу с дополнительными сертификатами.
# Если оставить пустым, приложение использует certs/russian_trusted_root_ca_pem.crt
# (файл скачивается автоматически при первом запуске).
GIGACHAT_CA_BUNDLE=

# Входящий вебхук Битрикс24 (необязательно)
# Приложения -> Вебхуки -> Входящий вебхук -> добавить с правом CRM
# Пример: https://your-domain.bitrix24.ru/rest/123456/abcdef123456/
B24_URL=https://b24-syi14p.bitrix24.ru/rest/1/elrhv1kfro8rm4nb/
BITRIX24_WEBHOOK_URL=https://b24-syi14p.bitrix24.ru/rest/1/elrhv1kfro8rm4nb/
